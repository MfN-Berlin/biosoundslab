ALLOW_EDIT=true

HASURA_ADMIN_SECRET=biosoundslab
HASURA_WEBHOOKS_BASE_URL=http://host.docker.internal:8000
HASURA_URL=172.17.0.1:10080/v1/graphql

DB_USERNAME=ecomon
DB_PASSWORD=ecomon
DB_ROOT_PASSWORD=ecomon
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecomon

BASE_DATA_DIRECTORY=/YOUR_DATA_DIRECTORY
REDIS_HOST=localhost
REDIS_PORT=6379

GITHUB_REPOSITORY_OWNER=mfn-berlin

# Backup
PGBACKUP_PATH=/YOUR_BACKUP_DIRECTORY
BACKUP_CHUNK_SIZE=1G
MAX_BACKUPS=3

#traefik
DOMAIN=localhost
SUB_PATH=/biosoundslab_next
ENTRY_PORT=80
PROTOCOL=http
TMP_DIR=/YOUR_TMP_DIR
USE_GPU=None
DB_WORKER_CONCURRENCY=2
INF_WORKER_CONCURRENCY=1

# .env.defaults - Development defaults for systems with 8-16GB RAM and 4+ CPU cores

# PostgreSQL Resource Limits
POSTGRES_MEMORY_LIMIT=4G
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_RESERVATION=2G
POSTGRES_CPU_RESERVATION=1.0

# PostgreSQL Performance Configuration
POSTGRES_SHM_SIZE=2G
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_MAINTENANCE_WORK_MEM=256MB
POSTGRES_WORK_MEM=64MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_DEFAULT_STATISTICS_TARGET=100
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_MIN_WAL_SIZE=1GB
POSTGRES_MAX_WAL_SIZE=4GB
POSTGRES_MAX_WORKER_PROCESSES=4
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=2
POSTGRES_MAX_PARALLEL_WORKERS=4
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=2
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_HUGE_PAGES=try
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000

# Hasura Configuration
HASURA_MEMORY_LIMIT=4G
HASURA_CPU_LIMIT=2.0
HASURA_MEMORY_RESERVATION=2G
HASURA_CPU_RESERVATION=1.0
HASURA_GRAPHQL_CONNECTIONS_PER_READ_REPLICA=50
HASURA_GRAPHQL_STRIPES_PER_READ_REPLICA=1
HASURA_GRAPHQL_POOL_TIMEOUT=360
HASURA_GRAPHQL_CONNECTION_LIFETIME=600
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_REFETCH_INTERVAL=1
HASURA_GRAPHQL_LIVE_QUERIES_MULTIPLEXED_BATCH_SIZE=100
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_DEV_MODE=true
HASURA_GRAPHQL_READ_ONLY_MODE=false
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=user
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log

# Redis Configuration
REDIS_MEMORY_LIMIT=2G
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_RESERVATION=1G
REDIS_CPU_RESERVATION=0.5
REDIS_MAXMEMORY=1536mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_SAVE_INTERVAL=900
REDIS_SAVE_CHANGES=1
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec
REDIS_TCP_KEEPALIVE=300
REDIS_TIMEOUT=0
REDIS_TCP_BACKLOG=511